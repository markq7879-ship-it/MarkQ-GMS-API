import { useState } from "react";
import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
import { Plus, Search, Snowflake, RefreshCw, Calendar } from "lucide-react";
import PageHeader from "../../components/PageHeader";
import EmptyState from "../../components/EmptyState";
import TableSkeleton from "../../components/TableSkeleton";
import { createMembership, freezeMembership, listMemberships, renewMembership } from "./api";
import CreateMembershipModal from "./CreateMembershipModal";
import FreezeMembershipModal from "./FreezeMembershipModal";
import RenewMembershipModal from "./RenewMembershipModal";
import type { CreateMembershipValues, FreezeValues, Membership } from "./types";

export default function MembershipsPage() {
  const qc = useQueryClient();
  const [search, setSearch] = useState("");
  const [createOpen, setCreateOpen] = useState(false);
  const [freezeTarget, setFreezeTarget] = useState<Membership | null>(null);
  const [renewTarget, setRenewTarget] = useState<Membership | null>(null);
  const [renewError, setRenewError] = useState<string | null>(null);
  const [renewTarget, setRenewTarget] = useState<Membership | null>(null);
  const [renewError, setRenewError] = useState<string | null>(null);

  const { data: memberships = [], isLoading } = useQuery({
    queryKey: ["memberships", search],
    queryFn: () => listMemberships(search || undefined),
  });

  const createMut = useMutation({
    mutationFn: (v: CreateMembershipValues) => createMembership(v),
    onSuccess: () => { qc.invalidateQueries({ queryKey: ["memberships"] }); setCreateOpen(false); },
  });

  const renewMut = useMutation({
    mutationFn: (id: string) => renewMembership(id),
    onSuccess: () => {
      qc.invalidateQueries({ queryKey: ["memberships"] });
      qc.invalidateQueries({ queryKey: ["dashboard-stats"] });
      qc.invalidateQueries({ queryKey: ["member"] });
      setRenewTarget(null);
      setRenewError(null);
    },
    onError: (e: any) => {
      setRenewError(e?.response?.data?.detail ?? "Failed to renew membership.");
    },
  });

function openRenew(m: Membership) {
    setRenewError(null);
    setRenewTarget(m);
  }

  const freezeMut = useMutation({
    mutationFn: ({ id, v }: { id: string; v: FreezeValues }) => freezeMembership(id, v),
    onSuccess: () => { qc.invalidateQueries({ queryKey: ["memberships"] }); setFreezeTarget(null); },
  });

  return (
    <div>
      <PageHeader title="Memberships" subtitle="Track active, expiring, frozen and expired memberships."
        actions={
          <button onClick={() => setCreateOpen(true)}
            className="flex items-center gap-1.5 px-3 py-2 text-sm bg-indigo-600 hover:bg-indigo-700 text-white rounded-md">
            <Plus className="w-4 h-4" /> New Membership
          </button>
        }
      />

      <div className="bg-white border border-slate-200 rounded-lg">
        <div className="p-4 border-b border-slate-200">
          <div className="relative max-w-sm">
            <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" />
            <input type="text" value={search} onChange={(e) => setSearch(e.target.value)}
              placeholder="Search by member or membership number…"
              className="w-full pl-9 pr-3 py-2 text-sm border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500" />
          </div>
        </div>

        {isLoading ? <TableSkeleton /> : memberships.length === 0 ? (
          <EmptyState icon={Calendar} title="No memberships yet"
            description="Create a membership to enroll a member into a plan." />
        ) : (
          <table className="w-full">
            <thead className="bg-slate-50 text-left text-xs uppercase text-slate-500">
              <tr>
                <th className="px-4 py-3">Membership #</th>
                <th className="px-4 py-3">Member</th>
                <th className="px-4 py-3">Plan</th>
                <th className="px-4 py-3">Start</th>
                <th className="px-4 py-3">End</th>
                <th className="px-4 py-3 text-right">Total</th>
                <th className="px-4 py-3">Status</th>
                <th className="px-4 py-3 text-right">Actions</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-slate-100">
              {memberships.map((m) => (
                <tr key={m.id} className="hover:bg-slate-50">
                  <td className="px-4 py-3 text-xs font-mono text-slate-600">{m.membershipNumber}</td>
                  <td className="px-4 py-3 text-sm">
                    <div className="font-medium text-slate-800">{m.memberName}</div>
                    <div className="text-xs font-mono text-slate-500">{m.memberCode}</div>
                  </td>
                  <td className="px-4 py-3 text-sm text-slate-700">{m.planName}</td>
                  <td className="px-4 py-3 text-sm text-slate-600">{m.startDate}</td>
                  <td className="px-4 py-3 text-sm text-slate-600">{m.endDate}</td>
                  <td className="px-4 py-3 text-sm text-right font-medium text-slate-800">₹{m.totalPayable.toFixed(2)}</td>
                  <td className="px-4 py-3">
                    <span className={`text-xs px-2 py-0.5 rounded-full ${
                      m.status === "ACTIVE" ? "bg-emerald-50 text-emerald-700" :
                      m.status === "FROZEN" ? "bg-amber-50 text-amber-700" :
                      m.status === "EXPIRED" ? "bg-slate-100 text-slate-600" :
                      "bg-rose-50 text-rose-700"
                    }`}>{m.status}</span>
                  </td>
                  <td className="px-4 py-3 text-right space-x-3">
                    {m.status === "ACTIVE" && (
                      <>
                        <button onClick={() => setFreezeTarget(m)}
                          className="inline-flex items-center gap-1 text-sm text-amber-600 hover:text-amber-700">
                          <Snowflake className="w-3.5 h-3.5" /> Freeze
                        </button>
                        <button onClick={() => openRenew(m)}
                          className="inline-flex items-center gap-1 text-sm text-indigo-600 hover:text-indigo-700">
                          <RefreshCw className="w-3.5 h-3.5" /> Renew
                        </button>
                      </>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>

      <CreateMembershipModal open={createOpen}
        onClose={() => setCreateOpen(false)}
        onSubmit={async (v) => { await createMut.mutateAsync(v); }} />

      <FreezeMembershipModal open={!!freezeTarget}
        onClose={() => setFreezeTarget(null)}
        onSubmit={async (v) => { if (freezeTarget) await freezeMut.mutateAsync({ id: freezeTarget.id, v }); }} />

      <RenewMembershipModal
        open={!!renewTarget}
        membership={renewTarget}
        onClose={() => {
          if (!renewMut.isPending) {
            setRenewTarget(null);
            setRenewError(null);
          }
        }}
        onConfirm={async () => {
          if (renewTarget) await renewMut.mutateAsync(renewTarget.id);
        }}
        isSubmitting={renewMut.isPending}
        error={renewError}
      />
      </div>
  );
}


